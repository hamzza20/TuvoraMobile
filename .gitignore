# Local MPVKit iOS build environment (sparse APFS image, see MPVKit docs)
.mpvkit-build.sparseimage
# The MPVKit checkout itself (the built iOS mpv framework, ~6G) — local-only, fetched/built per machine.
MPVKit/

# Hand-made backups of the built MPVKit binaries, kept next to the checkout before
# rebuilding the engine. Hundreds of MB of .xcframework output — the same artifacts
# the build produces, so they belong on disk, not in the repo. Dated, hence the glob.
MPVKit-dist-backup-*/
iosApp/Configuration/PostHog.local.xcconfig
